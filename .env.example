# Database Configuration
# Set DATABASE_URL for MySQL: mysql+pymysql://username:password@localhost:3306/volunteer_db
# Or leave default for SQLite auto-fallback: sqlite:///./volunteers.db
DATABASE_URL=sqlite:///./volunteers.db

# JWT Security
SECRET_KEY=super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Config
HOST=127.0.0.1
PORT=8000

# Admin Registration Security Key
ADMIN_REGISTRATION_KEY=admin-secret-key-2026

